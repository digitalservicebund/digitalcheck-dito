---
const titleId = `announcement-${crypto.randomUUID()}`;
---

<div class="breakout block! bg-kern-feedback-info-background py-16">
  <div class="container flex flex-wrap items-center">
    <span class="mr-8 flex items-center">
      <span
        class="kern-icon kern-icon--info kern-icon--default shrink-0 bg-kern-feedback-info"
        aria-hidden="true"
      ></span>
      <span id={titleId} class="kern-heading-small p-8">
        <slot />
      </span>
    </span>
    <!-- `contents` lets the body wrap onto its own full-width row below the title -->
    <details class="kern-details group details-content:basis-full contents">
      <summary class="kern-details__header py-8" aria-describedby={titleId}>
        <span class="kern-title kern-title--small group-open:hidden">
          Mehr dazu
        </span>
        <span class="kern-title kern-title--small not-group-open:hidden">
          Schließen
        </span>
      </summary>
      <div class="max-w-a11y py-8">
        <slot name="details" />
      </div>
    </details>
  </div>
</div>
