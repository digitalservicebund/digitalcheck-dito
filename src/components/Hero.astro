---
interface Props {
  class?: string;
  variant?: "default" | "plain" | "dark";
}

const { class: className, variant = "default" } = Astro.props;
const hasSubtitle = Astro.slots.has("subtitle");
---

<section
  class:list={[
    "breakout space-y-16 py-(--kern-metric-dimension-4x-large) [&_h1]:sm:hyphens-none",
    variant === "default" && "bg-kern-darkblue-100",
    variant === "dark" && "hero-dark bg-kern-darkblue-800",
    className,
  ]}
>
  <slot />
  {hasSubtitle && (
    <div class="ds-subhead mt-16 space-y-8">
      <slot name="subtitle" />
    </div>
  )}
</section>

<style>
  /* Re-map KERN's contextual colors so text and buttons render light-on-dark. */
  .hero-dark {
    --kern-color-layout-text-default-contextual: var(
      --kern-color-layout-text-inverse
    );
    --kern-color-action-default-contextual: var(--kern-color-white);
    --kern-color-action-on-default-contextual: var(--kern-color-darkblue-800);
    --kern-color-action-focus-default-contextual: var(--kern-color-white);
    /* KERN derives hover/active states from the non-contextual action color at :root, so re-derive them from white. */
    --kern-color-action-state-indicator-shade-hover: var(
      --kern-color-darkblue-050
    );
    --kern-color-action-state-indicator-shade-active: var(
      --kern-color-darkblue-100
    );
    --kern-color-action-state-indicator-tint-hover-opacity: color-mix(
      in oklab,
      var(--kern-color-white),
      transparent var(--kern-color-action-state-opacity-hover)
    );
    --kern-color-action-state-indicator-tint-active-opacity: color-mix(
      in oklab,
      var(--kern-color-white),
      transparent var(--kern-color-action-state-opacity-active)
    );
    color: var(--kern-color-layout-text-inverse);
  }
</style>
