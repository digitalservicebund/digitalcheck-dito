---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const hasSubtitle = Astro.slots.has("subtitle");
---

<section
  class:list={[
    "breakout bg-kern-darkblue-100 space-y-16 py-(--kern-metric-dimension-4x-large) [&_h1]:sm:hyphens-none",
    className,
  ]}
>
  <slot />
  {hasSubtitle && (
    <div class="ds-subhead mt-16 space-y-8">
      <slot name="subtitle" />
    </div>
  )}
</section>
