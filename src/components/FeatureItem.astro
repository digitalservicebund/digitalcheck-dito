---
interface Props {
  title?: string;
  body?: string;
}

const { title, body } = Astro.props;
---

<div class="flex flex-col gap-16 md:flex-1 md:pr-32">
  <div class="text-kern-action-default bg-lavender-400 flex size-110 flex-none items-center justify-center px-18 py-22">
    <slot name="icon" />
  </div>
  {title && <h3 class="m-0">{title}</h3>}
  {body && <p>{body}</p>}
  <slot />
</div>
