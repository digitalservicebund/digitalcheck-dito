---
import Modal from "@/components/Modal.astro";
import PruefbereichBreadcrumb from "@/components/wizard/PruefbereichBreadcrumb.astro";
import { pruefbereichOptions } from "@/wizard/pruefbereichSchema";
import type { WizardId } from "@/wizard/session";
import IconPublishedWithChanges from "~icons/ic/outline-published-with-changes";

// Slots:
// - startLabel / continueLabel: label of the start link, depending on whether answers are stored
// - restartLabel: label of the restart button, also used as the modal heading
// - modalBody: body of the restart modal

interface Props {
  wizardId: WizardId;
  /** Target of the start link. The continue link goes to the first unanswered question instead. */
  href: string;
  /** Shows the autosave hint while no answers are stored */
  showAutosaveHint?: boolean;
  /** Shows the select of the Prüfbereich above, which is stored when the wizard is started. Once stored (also by the other wizard), it's changed via the breadcrumb instead. */
  showPruefbereich?: boolean;
}

const {
  wizardId,
  href,
  showAutosaveHint = false,
  showPruefbereich = false,
} = Astro.props;

const modalId = `${wizardId}-start-over-modal`;
---

<div data-wizard-start-actions={wizardId} class="space-y-24">
  {showPruefbereich && (
    <>
      <div
        class="kern-form-input max-w-400"
        data-show-if-pruefbereich="none"
        hidden
      >
        <label class="kern-label" for={`${wizardId}-pruefbereich`}>
          Für welchen Bereich prüfen Sie?
        </label>
        <div class="kern-form-input__select-wrapper">
          <select
            class="kern-form-input__select"
            id={`${wizardId}-pruefbereich`}
          >
            {pruefbereichOptions.map(({ value, label }) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </div>
      </div>
      {/* Positioned for its menu on mobile */}
      <div class="relative" data-show-if-pruefbereich="stored" hidden>
        <PruefbereichBreadcrumb wizardId={wizardId} canEdit />
      </div>
    </>
  )}

  <div class="flex items-center gap-24">
    {/* Hidden until the script below knows whether answers are stored */}
    <a class="kern-btn kern-btn--primary" href={href} data-start-link hidden>
      <span class="kern-label" data-show-if="no-answers-stored">
        <slot name="startLabel" />
      </span>
      <span class="kern-label" data-show-if="answers-stored" hidden>
        <slot name="continueLabel" />
      </span>
      <span
        class="kern-icon kern-icon--arrow-forward"
        aria-hidden="true"
      ></span>
    </a>
    <button
      type="button"
      class="kern-btn kern-btn--tertiary"
      data-show-if="answers-stored"
      popovertarget={modalId}
      hidden
    >
      <span class="kern-label">
        <slot name="restartLabel" />
      </span>
      <span
        class="kern-icon kern-icon--autorenew kern-icon--default"
        aria-hidden="true"
      ></span>
    </button>
    <Modal id={modalId} contentClass="max-w-600 max-h-screen">
      <h2 slot="heading" class="kern-title kern-title--large mt-0">
        <slot name="restartLabel" />
      </h2>
      <p slot="body">
        <slot name="modalBody" />
      </p>
      <button
        type="button"
        class="kern-btn kern-btn--secondary"
        popovertarget={modalId}
        popovertargetaction="hide"
        slot="buttonLeft"
      >
        <span class="kern-label">Abbrechen</span>
      </button>
      <button
        type="button"
        class="kern-btn kern-btn--primary"
        popovertarget={modalId}
        popovertargetaction="hide"
        data-reset-wizard
        slot="buttonRight"
      >
        <span class="kern-label">Neu beginnen</span>
      </button>
    </Modal>
    {showAutosaveHint && (
      <div
        class="flex items-center gap-8"
        data-show-if="no-answers-stored"
        hidden
      >
        <IconPublishedWithChanges
          class="size-22 shrink-0 text-kern-layout-text-muted"
          aria-hidden="true"
        />
        <p class="kern-body kern-body--small py-0 text-kern-layout-text-muted">
          Ihre Angaben werden automatisch gespeichert.
          <br />
          Sie können die Seite jederzeit schließen und später fortfahren.
        </p>
      </div>
    )}
  </div>
</div>

<script>
  import { pruefbereich } from "@/wizard/pruefbereichSchema";
  import type { WizardId } from "@/wizard/session";
  import { $pruefbereich, wizardStores } from "@/wizard/stores";

  document
    .querySelectorAll<HTMLElement>("[data-wizard-start-actions]")
    .forEach((container) => {
      const wizardId = container.dataset.wizardStartActions as WizardId;
      const { $hasAnswers, $resumePath, reset } = wizardStores[wizardId];
      const startLink =
        container.querySelector<HTMLAnchorElement>("[data-start-link]");
      const pruefbereichSelect = document.getElementById(
        `${wizardId}-pruefbereich`,
      ) as HTMLSelectElement | null;
      const startHref = startLink?.getAttribute("href") ?? "";

      // Also updates when the answers change later, e.g. in another tab
      $hasAnswers.subscribe((hasAnswers) => {
        const visibleIf = hasAnswers ? "answers-stored" : "no-answers-stored";
        container
          .querySelectorAll<HTMLElement>("[data-show-if]")
          .forEach(
            (element) =>
              (element.hidden = element.dataset.showIf !== visibleIf),
          );
      });

      // Continuing jumps to the first unanswered question
      $resumePath.subscribe((resumePath) => {
        startLink?.setAttribute(
          "href",
          $hasAnswers.get() ? resumePath : startHref,
        );
      });

      // Shows the select until a Prüfbereich is stored, then the breadcrumb.
      // Also updates when it's stored later, e.g. by the other wizard in another tab.
      $pruefbereich.subscribe((stored) => {
        const visibleIf = stored ? "stored" : "none";
        container
          .querySelectorAll<HTMLElement>("[data-show-if-pruefbereich]")
          .forEach(
            (element) =>
              (element.hidden =
                element.dataset.showIfPruefbereich !== visibleIf),
          );
      });

      // Stored when starting, unless it's already stored and shown in the breadcrumb
      startLink?.addEventListener("click", () => {
        if (!pruefbereichSelect || $pruefbereich.get()) return;
        $pruefbereich.set(
          pruefbereich.safeParse(pruefbereichSelect.value).data,
        );
      });

      // Buttons starts hidden until html is hydrated,
      // to avoid flashing the wrong state.
      startLink?.removeAttribute("hidden");

      // Clears the answers once the user confirms the dialog and stays on the page.
      // Keeps the Prüfbereich, as it's shared with the other wizard.
      // Focuses the start link, as the restart button that opened the dialog is hidden now.
      container
        .querySelector("[data-reset-wizard]")
        ?.addEventListener("click", () => {
          reset();
          startLink?.focus();
        });
    });
</script>
