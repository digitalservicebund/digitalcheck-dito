---
import { pruefbereichLogos } from "@/assets/pruefbereich/logos";
import {
  assistent_dokumentation,
  assistent_vorpruefung,
} from "@/config/routes";
import { pruefbereichOptions } from "@/wizard/pruefbereichSchema";
import { wizardStorageKeys, type WizardId } from "@/wizard/session";
import { Image } from "astro:assets";

interface Props {
  wizardId: WizardId;
  /** Links to the start page to change the Prüfbereich, e.g. on the final page */
  showEditLink?: boolean;
}

const { wizardId, showEditLink = false } = Astro.props;

// Without Länder, there's nothing to change to
const isEditable = showEditLink && pruefbereichOptions.length > 1;

// The Prüfbereich is chosen on the start page
const startRoutes = {
  vorpruefung: assistent_vorpruefung,
  dokumentation: assistent_dokumentation,
} as const satisfies Record<WizardId, unknown>;
const startRoute = startRoutes[wizardId];
---

<!--
  Shows the Prüfbereich for the context slot of WizardLayout. One variant per
  option, as the stored one is only known in the browser; the Bund is shown
  without one.
-->
<div>
  {pruefbereichOptions.map(({ value, label }) => {
    const logo = pruefbereichLogos[value];
    return (
      <div
        class="flex flex-wrap items-center gap-x-kern-sm"
        data-pruefbereich={value}
        hidden={value !== "Bund"}
      >
        {logo && (
          <Image
            src={logo.image}
            alt=""
            width={logo.width}
            height={logo.height}
            densities={[1, 2]}
          />
        )}
        <p class="kern-body kern-body--small py-0 my-0">
          {startRoute.title} für:{" "}
          {isEditable ? (
            <a
              class="kern-link kern-link--small py-0 font-bold"
              href={startRoute.path}
            >
              {label}
              <span class="sr-only">ändern</span>
              <span
                class="kern-icon kern-icon--edit kern-icon--small"
                aria-hidden="true"
              />
            </a>
          ) : (
            <b>{label}</b>
          )}
        </p>
        {isEditable && (
          <p class="kern-preline kern-preline--small py-0 print:hidden">
            (Bisherige Angaben bleiben beim Wechsel erhalten)
          </p>
        )}
      </div>
    );
  })}
</div>

<!--
  Inline instead of bundled, so the stored Prüfbereich is shown before the
  page is painted. Reads localStorage like the wizard store, also after changes
  in another tab and when coming back via the browser history. An unknown one
  (e.g. a Land without the feature flag) shows the Bund, like the store's decoding.
-->
<script is:inline define:vars={{ storageKey: wizardStorageKeys[wizardId] }}>
  const variants = Array.from(
    document.currentScript.previousElementSibling.querySelectorAll(
      "[data-pruefbereich]",
    ),
  );
  const showStored = () => {
    let pruefbereich;
    try {
      ({ pruefbereich } = JSON.parse(localStorage.getItem(storageKey)) ?? {});
    } catch {
      // Unreadable storage counts as none
    }
    if (
      !variants.some((variant) => variant.dataset.pruefbereich === pruefbereich)
    ) {
      pruefbereich = "Bund";
    }
    variants.forEach(
      (variant) =>
        (variant.hidden = variant.dataset.pruefbereich !== pruefbereich),
    );
  };
  showStored();
  addEventListener("storage", showStored);
  addEventListener("pageshow", showStored);
</script>
