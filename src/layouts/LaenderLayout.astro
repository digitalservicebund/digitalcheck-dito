---
import Layout from "./Layout.astro";
import laenderMapUrl from "@/pages/bundeslaender/_assets/laender-map.svg?url";

interface Props {
  title: string;
  bundesland?: string;
}

const { title, bundesland } = Astro.props;
---

<Layout title={title}>
  <main class="breakout-grid">
    <div class="breakout bg-darkblue-100">
      <div class="flex flex-col lg:flex-row">
        <div class="space-y-24 py-32 sm:py-48 lg:w-1/2 lg:self-center lg:pr-48">
          <h1>{title}</h1>
          <slot name="subtitle" />
        </div>
        <div class="relative max-lg:mb-48 max-sm:hidden lg:w-1/2">
          <div
            class="flex h-full w-630 flex-col justify-center align-middle lg:w-[50vw]"
          >
            <div class="relative mx-auto h-400 py-24 lg:h-450">
              <img
                src={laenderMapUrl}
                alt="Eine stilisierte Karte von Deutschland"
                class="h-full w-auto object-contain"
              />
              {
                bundesland && (
                  <svg
                    viewBox="0 0 592 801"
                    class="absolute inset-0 h-full w-full"
                    aria-hidden="true"
                  >
                    <use
                      href={`${laenderMapUrl}#${bundesland}`}
                      fill="#a5b7e1"
                      stroke="#0e2792"
                      stroke-width="1.5"
                    />
                  </svg>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
    <slot />
  </main>
</Layout>

<style>
  @reference "../styles/globals.css";

  main {
    h2 {
      margin-bottom: 1rem;
    }

    section {
      @apply py-40 md:py-64;
    }
  }
</style>
