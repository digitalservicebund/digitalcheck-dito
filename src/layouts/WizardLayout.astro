---
import HelpSidepanel from "@/components/HelpSidepanel.astro";
import Layout from "@/layouts/Layout.astro";

type Props = {
  title: string;
  /** Shown as progress bar, e.g. "Prinzipien · Schritt 4 von 7" */
  progress?: { label?: string; current: number; total: number };
  isWide?: boolean;
};

const { title, progress, isWide = false } = Astro.props;
---

<!--
  Slots:
  - default: step content (heading, text, form)
  - context: context bar, e.g. "Vorprüfung für: Bund"
  - button-bar: <WizardButtonBar />
  - help: <HelpSection />s, shown in the help panel next to the content
  The section sidebar is rendered by Layout.astro.
-->
<Layout title={title} noFooter>
  <!-- h-full fills the sidebar grid cell, flex-1 the body without sidebar -->
  <div class="flex h-full min-w-0 flex-1">
    <div class="flex min-w-0 flex-1 flex-col">
      {Astro.slots.has("context") && (
        <div class="px-kern-md pt-kern-md pb-kern-sm">
          <slot name="context" />
        </div>
      )}
      <main
        class:list={["flex-1 pt-64 pb-80 print:pb-0", !isWide && "px-kern-md"]}
      >
        <!-- breakout-grid brings its own gutters and lets content span the full width -->
        <div
          class:list={[
            "space-y-kern-xl",
            isWide ? "breakout-grid" : "mx-auto w-full max-w-736",
          ]}
        >
          {progress && (
            <div class="kern-progress">
              <label for="wizard-progress" class="kern-label">
                {progress.label && `${progress.label} · `}Schritt{" "}
                {progress.current} von {progress.total}
              </label>
              <progress
                id="wizard-progress"
                value={progress.current}
                max={progress.total}
              />
            </div>
          )}
          <slot />
        </div>
      </main>
      <slot name="button-bar" />
    </div>
    {Astro.slots.has("help") && (
      <HelpSidepanel class="xl:w-300 xl:shrink-0 min-[94rem]:w-384">
        <slot name="help" />
      </HelpSidepanel>
    )}
  </div>
</Layout>
