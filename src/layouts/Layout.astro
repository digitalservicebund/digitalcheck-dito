---
import Posthog from "@/components/global/Posthog.astro";
import "@/styles/global.css";
import Footer from "@/components/global/Footer.astro";
import PageHeader from "@/components/global/PageHeader.astro";
import { siteMeta } from "@/resources/content/shared/meta";
import { isProduction } from "@/config/stage";
import { isNoIndexPath } from "@/config/seo";
import { withBase } from "@/utils/path";
import firaSansRegularUrl from "@kern-ux/native/dist/fonts/fira-sans/FiraSans-Regular.woff2?url";
import firaSansMediumUrl from "@kern-ux/native/dist/fonts/fira-sans/FiraSans-Medium.woff2?url";
import firaSansSemiBoldUrl from "@kern-ux/native/dist/fonts/fira-sans/FiraSans-SemiBold.woff2?url";
import {
  getRouteByPath,
  getRouteChain,
  hasVisibleChildren,
} from "@/utils/navigation/routeUtils";
import SectionSidebar from "@/components/global/SectionSidebar.astro";
import SkipNavLink from "@/components/SkipNavLink.astro";
import ogImagePath from "@/assets/images/og-image.png?url";

interface Props {
  title?: string;
  description?: string;
  noMenu?: boolean;
  noFooter?: boolean;
}

const {
  title,
  description = siteMeta.description,
  noMenu,
  noFooter = false,
} = Astro.props;

const noIndex = isNoIndexPath(Astro.url.pathname);

const pageTitle = title
  ? `${title} — ${siteMeta.siteName}`
  : siteMeta.titleWithTagline;

const canonicalUrl = Astro.url.href.replace(/\/$/, "");
const ogImage = `${Astro.url.origin}${ogImagePath}`;

const jsonLdMetadata = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteMeta.siteName,
  alternateName: siteMeta.alternateName,
  url: siteMeta.siteURL,
};

const currentRoute = getRouteByPath(Astro.url.pathname);
const [sectionRoot] = currentRoute ? getRouteChain(currentRoute) : [];
const showSectionSidebar =
  !!sectionRoot && hasVisibleChildren(sectionRoot) && !noMenu;
---

<!doctype html>
<html
  lang="de"
  class="scroll-smooth"
  transition:name="root"
  transition:animate="none"
  data-kern-theme="light"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="twitter:title" content={pageTitle} />

    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteMeta.siteName} />
    <meta property="og:description" content={description} />
    <meta property="twitter:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="twitter:card" content="summary_large_image" />
    {noIndex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <link
      rel="preload"
      href={firaSansRegularUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={firaSansMediumUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={firaSansSemiBoldUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {isProduction ? (
      <>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link
          rel="icon"
          href="/favicon_32.png"
          type="image/png"
          sizes="32x32"
        />
        <link
          rel="icon"
          href="/favicon_64.png"
          type="image/png"
          sizes="64x64"
        />
      </>
    ) : (
      <>
        <link
          rel="icon"
          type="image/png"
          href={withBase("/dachmarke/favicon-96x96.png")}
          sizes="96x96"
        />
        <link
          rel="icon"
          type="image/svg+xml"
          href={withBase("/dachmarke/favicon.svg")}
        />
        <link rel="shortcut icon" href={withBase("/dachmarke/favicon.ico")} />
        <link
          rel="apple-touch-icon"
          sizes="180x180"
          href={withBase("/dachmarke/apple-touch-icon.png")}
        />
        <meta name="apple-mobile-web-app-title" content="Digitalcheck" />
        <link rel="manifest" href={withBase("/dachmarke/site.webmanifest")} />
      </>
    )}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLdMetadata)}
    ></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <SkipNavLink label="Zum Inhalt springen" target="#main" />
    <PageHeader />
    {showSectionSidebar ? (
      <div class="flex-1 section-sidebar:grid section-sidebar:grid-cols-[264px_minmax(0,1fr)]">
        <SectionSidebar />
        <div>
          <slot />
        </div>
      </div>
    ) : (
      <slot />
    )}
    {!noFooter && <Footer />}
    {isProduction && <Posthog />}
  </body>
</html>
