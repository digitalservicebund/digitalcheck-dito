---
import {
  barrierefreiheit,
  bundeslaender,
  dasIstNeu,
  datenschutz,
  dokumentation,
  home,
  impressum,
  interoperabel,
  kontakt,
  methoden,
  normenkontrollrat,
  prinzipien,
  sitemap,
  vorpruefung,
} from "@/config/routes";
import { contact } from "@/resources/content/shared/contact";
import { withBase } from "@/utils/path";

const columns = [
  {
    title: "Digitalcheck machen",
    links: [
      { text: "Übersicht", url: home.path },
      { text: "Vorprüfung", url: vorpruefung.path },
      { text: "Regelung erarbeiten", url: methoden.path },
      { text: "Dokumentation", url: dokumentation.path },
    ],
  },
  {
    title: "Inhalte",
    links: [
      { text: "Fünf Prinzipien", url: prinzipien.path },
      { text: "EU-Interoperabilität", url: interoperabel.path },
      { text: "Bundesländer", url: bundeslaender.path },
      { text: "Normenkontrollrat", url: normenkontrollrat.path },
      { text: "Kontakt", url: kontakt.path },
    ],
  },
  {
    title: "Rechtliche Hinweise",
    links: [
      { text: "Impressum", url: impressum.path },
      { text: "Datenschutzerklärung", url: datenschutz.path },
      { text: "Barrierefreiheit", url: barrierefreiheit.path },
      { text: "Sitemap", url: sitemap.path },
      { text: "Das ist neu", url: dasIstNeu.path },
    ],
  },
];

const bmdsName = "Bundesministerium für Digitales und Staatsmodernisierung";
---

<footer
  id="footer"
  class="breakout-grid print:hidden"
  aria-label="Seitenfußbereich"
>
  <!-- Re-map KERN's contextual colors so text and links render light-on-dark. -->
  <div class="bg-kern-darkblue-800 breakout border-t-2 border-blue-300 [--kern-color-action-default-contextual:var(--kern-color-white)] [--kern-color-action-focus-default-contextual:var(--kern-color-white)] [--kern-color-action-visited:var(--kern-color-white)] [--kern-color-layout-text-default-contextual:var(--kern-color-layout-text-inverse)]">
    <div class="flex flex-col gap-40 pt-72 pb-40">
      <nav
        class="grid grid-cols-1 gap-32 sm:grid-cols-3"
        aria-label="Schnellübersicht"
      >
        {columns.map((column) => (
          <div class="kern-stack kern-stack-lg">
            <h2 class="kern-heading-medium mb-0">{column.title}</h2>
            <ul class="list-unstyled flex flex-col gap-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    class="increase-tap-area kern-link kern-link--small"
                  >
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <div class="kern-stack kern-stack-lg">
        <h2 class="kern-heading-medium mb-0">Kontaktieren Sie uns</h2>
        <p class="kern-body kern-body--small">
          Support:{" "}
          <a href={contact.phone} class="kern-link kern-link--small">
            {contact.phoneDisplay}
          </a>{" "}
          oder{" "}
          <a
            href={`mailto:${contact.email}`}
            class="kern-link kern-link--small"
          >
            {contact.email}
          </a>
        </p>
      </div>
      <p class="kern-body kern-body--small">
        Ein Angebot der{" "}
        <a
          href="https://digitalservice.bund.de/"
          target="_blank"
          rel="noreferrer"
          class="kern-link kern-link--small"
        >
          <span
            class="kern-icon kern-icon--open-in-new kern-icon--small"
            aria-hidden="true"
          ></span>
          DigitalService GmbH des Bundes
        </a>
      </p>
    </div>
  </div>

  <nav aria-label="Externe Verlinkungen" class="breakout bg-white">
    <div class="flex flex-col gap-16 py-40 sm:flex-row sm:gap-48">
      <img
        src={withBase("/logo/bmds-logo.svg")}
        width="137"
        alt={`Logo des ${bmdsName}`}
        class="shrink-0 self-start forced-colors:dark:hidden"
      />
      <img
        src={withBase("/logo/bmds-logo-white.svg")}
        width="137"
        alt={`Logo des ${bmdsName}`}
        class="hidden shrink-0 self-start forced-colors:dark:block"
      />
      <div class="max-w-3xl space-y-8 [&_p]:max-w-none">
        <h3 class="kern-label kern-label--small">Federführung</h3>
        <p class="kern-body kern-body--small">
          Der Digitalcheck entsteht im Auftrag des{" "}
          <a
            href="https://bmds.bund.de/"
            target="_blank"
            rel="noreferrer"
            class="kern-link kern-link--small"
          >
            <span
              class="kern-icon kern-icon--open-in-new kern-icon--small"
              aria-hidden="true"
            ></span>
            {bmdsName}
          </a>
        </p>
        <p class="kern-body kern-body--small">
          Mehr über den politischen Auftrag und die Entstehung des Digitalcheck
          finden Sie auf der{" "}
          <a
            href="https://www.digitale-verwaltung.de/Webs/DV/DE/transformation/digitalcheck/digitalcheck-node.html"
            target="_blank"
            rel="noreferrer"
            class="kern-link kern-link--small"
          >
            <span
              class="kern-icon kern-icon--open-in-new kern-icon--small"
              aria-hidden="true"
            ></span>
            Projektseite
          </a>{" "}
          des Bundesministeriums für Digitales und Staatsmodernisierung.
        </p>
      </div>
    </div>
  </nav>
</footer>
