---
import LaenderLayout from "@/layouts/LaenderLayout.astro";
import { Image } from "astro:assets";
import hessenLogo from "./_assets/HESSEN_Logo_stacked.png";
import {
  dokumentation,
  methoden,
  vorpruefung,
  methoden_fuenfPrinzipien,
} from "@/config/routes";

export const frontmatter = {
  title: "Digitalcheck Hessen",
  isStagingOnly: true,
};
---

<LaenderLayout title={frontmatter.title} bundesland="Hessen">
  <p slot="subtitle">
    Herzlich Willkommen beim Digitalcheck für das Land Hessen. Auf dieser Seite
    finden Sie nützliche Informationen und Hilfestellungen für eine
    digitaltaugliche Gestaltung Ihrer Rechtsnormen.
  </p>
  <section class="breakout space-y-16 bg-(--kern-color-layout-layer-surface-contextual)">
    <h2>Überblick</h2>
    <p>
      Gesetze, Rechtsverordnungen und Förderrichtlinien sind in Hessen so zu
      gestalten, dass der spätere Vollzug möglichst einfach und wirtschaftlich
      erfolgen kann. Digitale Fachverfahren und eine medienbruchfreie digitale
      Abwicklung von Prozessen können dazu in vielen Fällen einen wertvollen
      Beitrag leisten und Bürgerinnen und Bürger, Unternehmen und staatliche
      Stellen entlasten. § 18 HEGovG bündelt dieses im Koalitionsvertrag
      niedergelegte Ziel in Form einer gesetzlichen Verpflichtung.
    </p>
  </section>
  <section>
    <div class="flex items-center gap-48 pb-40">
      <Image src={hessenLogo} alt="Logo von Hessen" class="h-auto w-136" />
      <p>
        Der Digitalcheck des Landes ist ein Werkzeug, das Sie bei der
        Erarbeitung eines digitaltauglichen Regelungsvorhaben unterstützt.
        Anstelle einer abstrakten Checkliste erhalten Sie eine interaktive
        Schritt - für - Schritt - Unterstützung für die Visualisierung,
        Einschätzung, Gestaltung und Dokumentation ihres Regelungsvorhabens.
      </p>
    </div>
  </section>
  <section class="space-y-32!">
    <h2>So führen Sie Ihren Digitalcheck durch:</h2>
    <div class="space-y-16">
      <p>
        <span class="kern-number">1</span>
      </p>
      <h3>Vorprüfung</h3>
      <p>
        <a href={vorpruefung.path}>Prüfen</a> Sie zunächst, ob Ihr Vorhaben
        einen Digitalbezug hat oder Anforderungen an die EU‑Interoperabilität
        bestehen. Falls keiner der beiden Punkte gegeben ist, halten Sie dies im
        Gesetzesvorblatt fest.
      </p>
    </div>
    <div class="space-y-16">
      <p>
        <span class="kern-number">2</span>
      </p>
      <h3>Ausarbeitung</h3>
      <p>
        <a href={methoden.path}>Entwickeln</a> Sie ein Zielbild, indem Sie den
        Vollzug Ihrer Norm frühzeitig durchdenken und den{" "}
        <a href="https://zfl.bund.de/werkzeuge/">Ablaufprozess skizzieren</a>.
        Nutzen Sie dazu die unten aufgeführten allgemeinen und
        Hessen-spezifischen Hilfestellungen. Formulieren Sie anschließend den
        Normtext und berücksichtigen Sie dabei die{" "}
        <a href={methoden_fuenfPrinzipien.path}>
          Anforderungen der Digitaltauglichkeit
        </a>
        .
      </p>
    </div>
    <div class="space-y-16">
      <p>
        <span class="kern-number">3</span>
      </p>
      <h3>Dokumentation</h3>
      <p>
        <a href={dokumentation.path}>Dokumentieren</a> Sie, welche Aspekte Sie
        berücksichtigt und ins Regelungsvorhaben integriert haben, wie dadurch
        Digitaltauglichkeit und EU‑Interoperabilität sichergestellt werden, und
        welche digitalen Kriterien Sie adressiert haben; laden Sie die
        Ergebnisse herunter oder nutzen Sie die Word‑Vorlage. Das Ergebnis der
        Dokumentation kann als Anlage dem Gesetzesvorhaben beigefügt werden.
      </p>
    </div>
  </section>
  <section class="breakout bg-darkblue-100 space-y-16">
    <h2>Links und Ansprechpartner von A - Z</h2>
    <p>
      Nachfolgend finden Sie einige nützliche Links und Ansprechpartner, die Sie
      im Prozess nicht unbedingt benötigen, hier aber bei Bedarf einmal
      aufgelistet zur Verfügung haben.
    </p>
    <ul>
      <li>
        <a
          href="https://map.intern.hessen.de/irj/go/hessen/startseite/fachinformationen/recht/normgebung-und-pruumlfung/vorschriftencontrolling?area=Land-Hessen"
          target="_blank"
        >
          Arbeitsgruppe Verwaltungsvereinfachung (Dokumente)
        </a>
        <br />
      </li>
      <li>
        <a
          href="https://map.intern.hessen.de/irj/go/hessen/startseite/fachinformationen/recht/hessen-norm/egesetz/konzept-und-arbeitshilfen"
          target="_blank"
        >
          eGesetz Hessen (Konzept und Arbeitshilfen)
        </a>
      </li>
      <li>
        <a
          href="https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX%3A32024R0903"
          target="_blank"
        >
          Europäische Interoperabilitätsverordnung
        </a>
      </li>
      <li>
        <a href="https://fimportal.de/" target="_blank">
          FIM Portal
        </a>
      </li>
      <li>
        <a href="https://datenschutz.hessen.de/" target="_blank">
          Hessischer Beauftragter für Datenschutz und Informationsfreiheit
        </a>
      </li>
      <li>
        <a
          href="https://www.rv.hessenrecht.hessen.de/bshe/document/jlr-NNLHE000053F5NN00000000029"
          target="_blank"
        >
          Hessisches E-Government-Gesetz (§ 18)
        </a>
      </li>
      <li>
        <a
          href="https://hessen.de/sites/hessen.hessen.de/files/2024-01/koalitionsvertrag_fuer_die_21._legislaturperiode.pdf"
          target="_blank"
        >
          Hessischer Koalitionsvertrag 2024 – 2029 (Auszug)
        </a>
      </li>
      <li>
        <a href="https://interoperable-europe.ec.europa.eu/" target="_blank">
          Interoperable Europe Portal
        </a>
      </li>
      <li>
        <a
          href="https://informationsplattform.ozg-umsetzung.de/iNG/app/intro"
          target="_blank"
        >
          OZG - Informationsplattform
        </a>
      </li>
      <li>
        <a href="https://zfl.bund.de/" target="_blank">
          Zentrum für Legistik
        </a>
      </li>
    </ul>
  </section>
  <section>
    <h2>Schulungen</h2>
    <p>Schulungsangebote folgen.</p>
  </section>
</LaenderLayout>
