---
import {
  dokumentation,
  grundlagen_normenkontrollrat,
  methoden,
  methoden_fuenfPrinzipien,
  unterstuetzung,
  vorpruefung,
} from "@/config/routes";
import Layout from "@/layouts/Layout.astro";
import {
  ContactPhoneOutlined as ContactPhoneOutlinedIcon,
  FactCheckOutlined as FactCheckOutlinedIcon,
  WidgetsOutlined as WidgetsOutlinedIcon,
} from "@digitalservicebund/icons";
import Badge from "@/components/Badge";
import { LinkButton } from "@/components/Button";
import Heading from "@/components/Heading";
import { BreakoutHero } from "@/components/Hero";
import InfoBox from "@/components/InfoBox";
import InfoBoxSideBySide from "@/components/InfoBoxSideBySide";
import RichText from "@/components/RichText";
import { withBase } from "@/utils/path";
import { dedent } from "@/utils/dedentMultilineStrings";
import { ZFL_BASE_URL } from "@/resources/constants";

export const frontmatter = {
  title: "Startseite",
};

const steps = [
  {
    number: 1,
    title: "Digitalbezug einschätzen",
    link: {
      text: "Digitalbezug einschätzen",
      to: vorpruefung.path,
      look: "primary" as const,
    },
    procedure:
      "Sie identifizieren Digitalbezug und Inter&shy;operabilitäts&shy;an&shy;for&shy;der&shy;un&shy;gen für Ihr Vorhaben.",
    duration: "Wenige Minuten",
    result: dedent`
      - Individueller Digital- und Interoperabilitätsbezug
      - Ergebnis als E-Mail an Prüfstelle* schicken oder als Dokumentation zur Selbstprüfung nutzen.
    `,
  },
  {
    number: 2,
    title: "Digitaltauglichkeit der Regelung sicherstellen",
    link: {
      text: "Regelung erarbeiten",
      to: methoden.path,
      look: "tertiary" as const,
    },
    procedure:
      "Bei einer positiven Vorprüfung wenden Sie die Werkzeuge und Methoden an, die die Digitaltauglichkeit Ihres Vorhabens sicherstellen.",
    duration: "Punktuell über die gesamte Zeit der Regelungsausarbeitung",
    result: dedent`
      - Ihre Regelung wird digitaltauglich
      - Visualisierungen zur digitaltauglichen Umsetzung Ihrer Regelung
    `,
  },
  {
    number: 3,
    title: "Dokumentieren der Digitaltauglichkeit",
    link: {
      text: "Dokumentation erstellen",
      to: dokumentation.path,
      look: "tertiary" as const,
    },
    procedure:
      "Sie dokumentieren, wie Sie Digitaltauglichkeit in Ihrer Regelung sichergestellt haben.",
    duration: "Ein bis zwei Stunden",
    result: dedent`
      - Ausgefülltes Word-Dokument - welches Sie an Ihre jeweilige Prüfstelle* senden
      - Ihr Vorhaben ist formal bereit für die Ressortabstimmung
    `,
  },
];
---

<Layout>
  <main class="breakout-grid">
    <BreakoutHero
      title="Digitaltaugliche Regelungen erarbeiten"
      subtitle="Der Digitalcheck ist eine Prozessbegleitung für Ihr Regelungsvorhaben. Sie stellen damit Digitaltauglichkeit sicher."
      className="bg-blue-800 text-white"
    />

    <div class="py-40 lg:py-80">
      <Heading tagName="h2" text="Schritt für Schritt" className="mb-40" />

      <div class="relative">
        <div
          class="absolute h-16 w-16 rounded-full bg-blue-300 max-lg:-bottom-8 max-lg:left-10 lg:-top-6 lg:-right-1"
        >
        </div>
        <ol
          class="list-unstyled max-w-none max-lg:mx-16 lg:grid lg:grid-flow-col lg:grid-cols-3 lg:grid-rows-[repeat(6,auto)]"
        >
          {
            steps.map((step) => (
              <li class="relative border-blue-300 max-lg:border-l-3 max-lg:pb-40 max-lg:pl-40 lg:row-span-6 lg:grid lg:grid-rows-subgrid lg:border-t-3 lg:pr-40">
                <div class="absolute flex h-40 w-40 items-center justify-center rounded-full bg-blue-800 font-bold text-white max-lg:left-[-22px] lg:-top-20">
                  {step.number}
                </div>
                <Heading
                  tagName="h3"
                  text={step.title}
                  className="ds-heading-03-bold lg:mt-40"
                />
                <div class="mt-40 self-center">
                  <LinkButton href={step.link.to} look={step.link.look}>
                    {step.link.text}
                  </LinkButton>
                </div>
                <div class="mt-40">
                  <p class="font-bold">Vorgehen:</p>
                  <RichText markdown={step.procedure} />
                </div>
                <div class="mt-24 border-t-2 border-gray-400 pt-16">
                  <p class="font-bold">Dauer:</p>
                  <RichText markdown={step.duration} />
                </div>
                <div class="mt-24">
                  <p class="font-bold">Ergebnis:</p>
                  <RichText markdown={step.result} />
                  {step.number === 1 && (
                    <p class="mt-16">
                      * Auf Bundesebene ist zum Beispiel der Normenkontrollrat
                      (NKR) die zuständige Prüfstelle.
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="breakout space-y-40 bg-blue-100 py-40 lg:py-80">
      <Heading tagName="h2" text="Einführung zum Digitalcheck" />
      <InfoBox
        visual={{ type: "icon", Icon: WidgetsOutlinedIcon }}
        look="highlight"
        className="bg-white"
      >
        <Heading tagName="h3"> Was ist Digitaltauglichkeit? </Heading>
        <RichText
          markdown="Digitaltaugliche Regelungen ermöglichen eine rechtlich und technisch reibungslose digitale Umsetzung und fördern die automatisierte Bearbeitung von Verfahrensschritten."
        />
        <InfoBox.LinkList
          links={[
            {
              text: "Mehr zur Digitaltauglichkeit erfahren",
              to: "https://zfl.bund.de/werkzeuge/digitaltauglichkeit",
              look: "ghost",
            },
          ]}
        />
      </InfoBox>

      <InfoBox
        visual={{ type: "icon", Icon: FactCheckOutlinedIcon }}
        look="highlight"
        className="bg-white"
      >
        <Badge look="hint" className="mr-8" text="Bundesebene" />
        <Heading tagName="h3">
          Worauf achtet der Nationale Normenkontrollrat?
        </Heading>
        <RichText
          markdown="Der Nationale Normenkontrollrat (NKR) prüft das Vorhaben auf Digitaltauglichkeit. Mit der Anwendung der **Prinzipien** und Erstellung von **Visualisierungen** kann der Nationale Normenkontrollrat die Digitaltauglichkeit besser und schneller nachvollziehen."
        />
        <InfoBox.LinkList
          links={[
            {
              text: `Mehr zum NKR erfahren`,
              to: grundlagen_normenkontrollrat.path,
              look: "ghost",
            },
          ]}
        />
      </InfoBox>
    </div>

    <div
      class="breakout bg-cover bg-center"
      style={{
        backgroundImage: `url(${withBase("/images/trainings.jpg")})`,
      }}
    >
      <div class="py-40 lg:py-80">
        <InfoBoxSideBySide>
          <InfoBox look="method" className="bg-white">
            <Heading tagName="h3">
              Das Potenzial von Visualisierungen nutzen
            </Heading>
            <RichText
              markdown="Visualisierungen helfen bestehende Abläufe Ihrer Regelung einfach sichtbar zu machen und Digitaltauglichkeit einzuschätzen."
            />
            <InfoBox.LinkList
              links={[
                {
                  text: "Zu Visualisierungen",
                  to: ZFL_BASE_URL + "/werkzeuge/ressourcen/flussdiagramm",
                  look: "tertiary",
                  externalLink: true,
                },
                {
                  text: "Beispiele",
                  to: ZFL_BASE_URL + "/werkzeuge/ressourcen/visualisierungen",
                  look: "ghost",
                  externalLink: true,
                },
              ]}
            />
          </InfoBox>

          <InfoBox look="method" className="bg-white">
            <Heading tagName="h3">
              Prinzipien als Grundlage für Digitaltauglichkeit einsetzen
            </Heading>
            <RichText
              markdown="Fünf Prinzipien helfen Ihnen dabei, Chancen der digitalen Umsetzung auszuschöpfen und Hindernisse zu erkennen."
            />
            <InfoBox.LinkList
              links={[
                {
                  text: "Zu den Prinzipien",
                  to: methoden_fuenfPrinzipien.path,
                  look: "tertiary",
                },
                {
                  text: "Beispiele",
                  to:
                    ZFL_BASE_URL +
                    "/werkzeuge/digitaltauglichkeit/beispiele-im-regelungstext",
                  look: "ghost",
                  externalLink: true,
                },
              ]}
            />
          </InfoBox>
        </InfoBoxSideBySide>
      </div>
    </div>

    <div class="space-y-48 py-40 lg:py-80">
      <InfoBox>
        <Heading tagName="h2">
          Individuelle Unterstützung für Ihr Vorhaben
        </Heading>
        <RichText
          markdown="Nutzen Sie unsere persönlichen Unterstützungsangebote, um Ihr Regelungsvorhaben digitaltauglich zu gestalten und den Prozess erfolgreich zu durchlaufen."
        />
        <InfoBox.LinkList
          links={[
            {
              text: "Angebote kennenlernen",
              to: unterstuetzung.path,
              look: "tertiary",
            },
          ]}
        />
      </InfoBox>

      <InfoBox
        look="highlight"
        className="bg-blue-100"
        visual={{ type: "icon", Icon: ContactPhoneOutlinedIcon }}
      >
        <Heading tagName="h3" className="ds-heading-03-reg mb-16">
          „Der Digitalcheck erscheint mit den Hilfestellungen unkomplizierter
          als gedacht.“
        </Heading>
        <RichText markdown="**Referentin**<br>aus einem Bundesministerium" />
      </InfoBox>
    </div>
  </main>
</Layout>
