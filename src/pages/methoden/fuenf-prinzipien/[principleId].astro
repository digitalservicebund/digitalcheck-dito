---
import Layout from "@/layouts/Layout.astro";
import KernBadge from "@/components/KernBadge.astro";
import RichText from "@/components/RichText.tsx";
import Hero from "@/components/Hero.astro";
import TocContainer from "@/components/TocContainer.astro";
import type { Prinzip } from "@/content.config";
import { getCollection } from "astro:content";
import Aspect from "./_Aspect.astro";
import PrincipleNavigation from "./_PrincipleNavigation.astro";

export const frontmatter = {
  title: "Fünf Prinzipien",
  sitemap: false,
};

type PrinzipWithBeschreibung = Prinzip & { Beschreibung: string };

export async function getStaticPaths() {
  const entries = await getCollection("prinzipien");

  // The overview description (`Beschreibung`) lives in the Markdown body,
  // not the frontmatter `data`, so it has to be pulled in separately here.
  const prinzips: PrinzipWithBeschreibung[] = entries
    .map((entry) => ({ ...entry.data, Beschreibung: entry.body ?? "" }))
    .sort((a, b) => a.order - b.order);

  const prinzipList = prinzips.map(({ Name, URLBezeichnung, order }) => ({
    Name,
    URLBezeichnung,
    order,
  }));

  return prinzips.map((prinzip) => ({
    params: { principleId: prinzip.URLBezeichnung },
    props: { prinzip, prinzipList },
  }));
}

const { prinzip, prinzipList } = Astro.props;

const title = prinzip ? `Prinzip: ${prinzip.Name}` : "Fünf Prinzipien";
---

<Layout title={title}>
  <main>
    <div class="breakout-grid-toc">
      <Hero>
        <div>
          <KernBadge
            class="-mb-16"
            variant={`prinzip-${prinzip.order}`}
            showIcon={false}
          >
            Prinzip {prinzip.order}
          </KernBadge>
        </div>
        <h1>{prinzip.Name}</h1>
        <RichText
          className="ds-subhead mt-16 space-y-16"
          markdown={prinzip.Beschreibung}
        />
      </Hero>
    </div>
    <TocContainer>
      {prinzip.Aspekte.map((aspect, index) => (
        <Aspect
          aspect={aspect}
          prinzip={prinzip}
          class={index % 2 === 1 ? "bg-kern-darkblue-025" : undefined}
        />
      ))}
    </TocContainer>
    <div class="breakout-grid-toc my-80">
      <PrincipleNavigation principles={prinzipList} current={prinzip} />
    </div>
  </main>
</Layout>
