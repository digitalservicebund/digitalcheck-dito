---
import Layout from "@/layouts/Layout.astro";
import { ArrowForward, Email, Phone } from "@digitalservicebund/icons";
import Hero from "@/components/Hero.astro";
import KernCard from "@/components/KernCard.astro";
import {
  interoperabel_nationaleKontaktstelle,
  vorpruefung,
} from "@/config/routes";
import {
  ZFL_BASE_URL,
  ZFL_PATH_DIGITALTAUGLICHKEIT,
} from "@/resources/constants";
import { contact } from "@/resources/content/shared/contact";
import { withBase } from "@/utils/path";
import regelungsbegleitungImage from "@/assets/images/regelungsbegleitung.png";
import schulungenImage from "@/assets/images/schulungen.jpg";
import werkzeugeImage from "@/assets/images/werkzeuge.jpg";

export const frontmatter = {
  title: "Kontakt",
  isStagingOnly: true,
};

const iconClass = "size-20 shrink-0 fill-blue-800";
---

<Layout title={frontmatter.title}>
  <main class="breakout-grid">
    <Hero>
      <h1>Sprechen Sie uns an</h1>
      <p>
        Das Digitalcheck-Team beantwortet Ihre Fragen rund um das Thema
        Digitaltauglichkeit in Regelungsvorhaben.
      </p>
      <ul class="list-unstyled space-y-8">
        <li class="flex items-center gap-8">
          <Phone className={iconClass} />
          <a href={contact.phone}>{contact.phoneDisplay}</a>
        </li>
        <li class="flex items-center gap-8">
          <Email className={iconClass} />
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
      </ul>
    </Hero>
    <section>
      <h2>Welche Frage haben Sie?</h2>
      <div class="mt-32 grid grid-cols-1 gap-24 md:grid-cols-2">
        <KernCard
          title="Fragen zum Digitalcheck"
          body="Vorprüfung, Digitaltauglichkeit, Dokumentation."
          background="white"
        >
          <ul class="list-unstyled space-y-8">
            <li class="flex items-center gap-8">
              <Phone className={iconClass} />
              <a href={contact.phone}>{contact.phoneDisplay}</a>
            </li>
            <li class="flex items-center gap-8">
              <Email className={iconClass} />
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
          </ul>
        </KernCard>
        <KernCard
          title="Fragen zur EU-Interoperabilität"
          body="Interoperabilitätsbewertung, Verordnung (EU) 2024/903, Berichtspflichten."
          background="white"
        >
          <ul class="list-unstyled space-y-8">
            <li class="flex items-center gap-8">
              <Email className={iconClass} />
              <a href={`mailto:${contact.interoperabilityEmail}`}>
                {contact.interoperabilityEmail}
              </a>
            </li>
            <li class="flex items-center gap-8">
              <ArrowForward className={iconClass} />
              <a href={withBase(interoperabel_nationaleKontaktstelle.path)}>
                Zur Nationalen Kontaktstelle
              </a>
            </li>
          </ul>
        </KernCard>
      </div>
    </section>
    <section class="breakout bg-gray-200">
      <h2>Angebote beim Zentrum für Legistik</h2>
      <p>
        Schulungen, Werkzeuge und individuelle Unterstützung erhalten Sie beim
        Zentrum für Legistik (ZfL).
      </p>
      <div class="mt-32 grid grid-cols-1 gap-24 md:grid-cols-2 lg:grid-cols-3">
        <KernCard
          title="Schulungen"
          href={`${ZFL_BASE_URL}/schulungen`}
          body="Praxisnahe Schulungen zu Digitaltauglichkeit und den fünf Prinzipien."
          image={schulungenImage}
          imageAlt="Symbolbild: Ein Laptop zeigt die fünf Prinzipien des Digitalchecks"
          background="white"
        />
        <KernCard
          title="Werkzeuge & Beispiele"
          href={`${ZFL_BASE_URL}${ZFL_PATH_DIGITALTAUGLICHKEIT}`}
          body="Methoden, Leitfäden und Beispiele zum direkten Nachnutzen."
          image={werkzeugeImage}
          imageAlt="Symbolbild: Erstellung eines Flussdiagramms"
          background="white"
        />
        <KernCard
          title="Regelungsbegleitung"
          href={`${ZFL_BASE_URL}/begleitungen`}
          body="Individuelle Unterstützung durch interdisziplinäre Teams, u. a. zu Digitaltauglichkeit."
          image={regelungsbegleitungImage}
          imageAlt="Mehrere Personen vor einem großen Whiteboard, an dem sie Klebepunkte an bereits vorhandenen Papieren und Post-its anbringen."
          background="white"
        />
      </div>
    </section>
    <section>
      <h2>Noch keine Vorprüfung gemacht?</h2>
      <p>
        In wenigen Minuten wissen Sie, ob ein Digitalbezug besteht oder nicht.
      </p>
      <a
        href={withBase(vorpruefung.path)}
        class="kern-btn kern-btn--primary link-unstyled mt-16"
      >
        <span class="kern-label">Zur Vorprüfung</span>
      </a>
    </section>
  </main>
</Layout>
