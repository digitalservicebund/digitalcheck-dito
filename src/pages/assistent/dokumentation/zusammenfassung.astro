---
import { assistent_dokumentation } from "@/config/routes";
import { slugify } from "@/utils/utilFunctions";
import { toPrinzipOrder } from "@/wizard/dokumentationSchema";
import { getCollection } from "astro:content";
import Zusammenfassung, { type PrinzipSummary } from "./_Zusammenfassung";
import StepPage from "./_StepPage.astro";

export const frontmatter = {
  title: "Zusammenfassung",
  sitemap: false,
  navOrder: 9,
};

// Paths and Schwerpunkte as on the Prinzip pages ([principleId].astro)
const prinzipien: PrinzipSummary[] = (await getCollection("prinzipien"))
  .map(({ data }) => ({
    order: toPrinzipOrder(data.order),
    name: data.Name,
    path: `${assistent_dokumentation.path}/${data.URLBezeichnung}`,
    schwerpunkte: Object.fromEntries(
      data.Aspekte.map((aspekt) => [
        slugify(aspekt.Kurzbezeichnung),
        aspekt.Kurzbezeichnung,
      ]),
    ),
  }))
  .toSorted((a, b) => a.order - b.order);
---

<StepPage title={frontmatter.title}>
  <div class="space-y-32">
    <div class="space-y-16">
      <h1 class="kern-heading-large">{frontmatter.title}</h1>
      <p>
        Prüfen Sie Ihre Angaben, bevor Sie die Dokumentation absenden. Über
        „Bearbeiten“ kommen Sie zurück zum jeweiligen Schritt.
      </p>
    </div>
    {/* The answers are only stored in the browser */}
    <Zusammenfassung client:only="react" prinzipien={prinzipien} />
  </div>
</StepPage>
